# ============================================================
#  SynixAI — Konfigurasi Environment
#  Salin file ini menjadi .env.local lalu isi nilainya.
#  JANGAN commit .env.local ke repo publik.
# ============================================================

# --- Kredensial panel SMM Nusantara -------------------------
# API URL = base URL panel (tanpa /api/... di belakangnya)
SMM_API_URL=https://smmnusantara.id
SMM_API_ID=56150
SMM_API_KEY=isi-api-key-anda

# --- Branding situs ----------------------------------------
NEXT_PUBLIC_SITE_NAME=SynixAI
NEXT_PUBLIC_SITE_TAGLINE=Panel SMM Termurah & Tercepat di Indonesia
NEXT_PUBLIC_SITE_URL=https://synixai.id

# Nomor WhatsApp admin, format internasional tanpa "+" (62 = Indonesia)
NEXT_PUBLIC_WA_NUMBER=6281234567890
NEXT_PUBLIC_SUPPORT_EMAIL=support@synixai.id

# ============================================================
#  HARGA JUAL (MARGIN KEUNTUNGAN)
# ============================================================
# Harga panel = modal. Harga yang tampil ke customer = modal × markup.
#
# Opsi A (disarankan) — markup bertingkat, dibiarkan kosong/0:
#   Layanan murah dimarkup besar, layanan mahal dimarkup kecil,
#   sehingga semua kelas harga tetap masuk akal di pasar.
NEXT_PUBLIC_PRICE_MARKUP=0

# Opsi B — markup flat (persen) untuk SEMUA layanan.
# Isi angka > 0 untuk mengabaikan markup bertingkat. Contoh: 100 = harga 2x modal.
# NEXT_PUBLIC_PRICE_MARKUP=100

# Opsi C — atur sendiri tingkatan markup (JSON).
# Format: [[batas_modal_per_1000, pengali], ...] — urut menaik,
# batas 0 / dihilangkan = tanpa batas (tier terakhir).
# Contoh: modal ≤3rb dikali 3, ≤20rb dikali 2, sisanya 1,4
# PRICING_TIERS=[[3000,3],[20000,2],[0,1.4]]

# Laba minimum per 1.000 unit (Rp). Menjaga tetap untung di layanan super murah.
PRICING_MIN_PROFIT=1000

# Pembulatan harga jual: 0 = otomatis (100 / 500 / 1.000 / 10.000 / 100.000)
PRICING_ROUND_STEP=0

# ============================================================
#  ALUR PEMESANAN
# ============================================================
# 0 (AMAN, default) = customer menyelesaikan pembayaran dulu, lalu admin
#                     klik "Kirim ke panel" di halaman /admin. Saldo panel
#                     tidak akan terkuras oleh pesanan yang tidak dibayar.
# 1 (INSTAN)        = pesanan langsung diteruskan ke panel tanpa pembayaran.
#                     Hanya aktifkan bila pembayaran sudah otomatis
#                     (payment gateway / saldo tersimpan pelanggan).
ORDER_AUTO_SUBMIT=0

# --- Info pembayaran (tampil di halaman sukses pemesanan) ----
NEXT_PUBLIC_PAYMENT_QRIS_NAME=SynixAI
NEXT_PUBLIC_PAYMENT_BANK=BCA
NEXT_PUBLIC_PAYMENT_BANK_ACCOUNT=1234567890
NEXT_PUBLIC_PAYMENT_BANK_HOLDER=Nama Pemilik Rekening
NEXT_PUBLIC_PAYMENT_EWALLET_LABEL=DANA / OVO / GoPay / ShopeePay
NEXT_PUBLIC_PAYMENT_EWALLET_NUMBER=6281234567890
NEXT_PUBLIC_PAYMENT_EWALLET_HOLDER=Nama Pemilik
# Masa berlaku penawaran harga sebelum pesanan dianggap batal (menit)
PAYMENT_QUOTE_MINUTES=120

# ============================================================
#  PAYMENT GATEWAY (pembayaran otomatis)
# ============================================================
# manual = tanpa gateway: customer bayar manual (QRIS/transfer/e-wallet),
#          admin mengonfirmasi lewat dashboard /admin.
# mock   = SIMULASI lokal untuk menguji alur (tidak ada uang berpindah).
# tripay | midtrans | doku | duitku | xendit | ipaymu = provider asli.
#
# Setelah gateway aktif, pesanan yang sudah DIBAYAR otomatis dikirim ke panel
# (lihat ORDER_AUTO_SUBMIT_PAID) sehingga Anda tidak perlu konfirmasi manual.
PAYMENT_PROVIDER=manual
# sandbox = uji coba, production = uang sungguhan
PAYMENT_MODE=sandbox

# --- Kredensial (nama variabel disamakan; arti per provider) --------------
# tripay   : PAYMENT_API_KEY=API Key, PAYMENT_PRIVATE_KEY=Private Key, PAYMENT_MERCHANT_CODE=Merchant Code
# midtrans : PAYMENT_API_KEY=Server Key
# doku     : PAYMENT_MERCHANT_CODE=Client-Id, PAYMENT_PRIVATE_KEY=Secret Key
# duitku   : PAYMENT_MERCHANT_CODE=Merchant Code, PAYMENT_API_KEY=API Key
# xendit   : PAYMENT_API_KEY=Secret Key, PAYMENT_WEBHOOK_TOKEN=Callback Token
# ipaymu   : PAYMENT_MERCHANT_CODE=VA, PAYMENT_API_KEY=API Key
PAYMENT_API_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_MERCHANT_CODE=

# URL API khusus (opsional) — untuk mengganti base URL provider.
PAYMENT_API_URL=

# Kanal pembayaran sesuai kode provider.
#   tripay : QRIS | BRIVA | BNCVA | OVO | DANA | SHOPEEPAY
#   duitku : DQ (QRIS) | VC (VA) | dll
PAYMENT_METHODS=QRIS

# Biaya gateway. bearer=customer → biaya ditambahkan ke total tagihan
# sehingga laba Anda tidak berkurang. bearer=merchant → Anda yang menanggung.
PAYMENT_FEE_PERCENT=0.7
PAYMENT_FEE_FLAT=0
PAYMENT_FEE_BEARER=customer

# Token verifikasi webhook (wajib untuk Xendit & mode mock, opsional lainnya).
PAYMENT_WEBHOOK_TOKEN=

# Masa berlaku halaman pembayaran gateway (menit).
PAYMENT_EXPIRES_MINUTES=60

# 1 (default) = begitu pembayaran terverifikasi, pesanan langsung dikirim ke
# panel memakai saldo panel. 0 = masuk daftar "siap dikirim" di /admin dulu.
ORDER_AUTO_SUBMIT_PAID=1

# URL publik website untuk URL webhook & halaman kembali (return URL).
# Kosongkan agar otomatis memakai host dari request (aman untuk preview).
PUBLIC_BASE_URL=

# --- Katalog -----------------------------------------------
# Lama cache katalog di server (detik). Katalog ditarik ulang dari panel
# setelah waktu ini. 600 = 10 menit.
CATALOG_REVALIDATE_SECONDS=600
# Ubah ke "1" untuk selalu memakai data/services.json (offline mode)
CATALOG_FORCE_OFFLINE=0

# --- Halaman diagnosa (/admin) ------------------------------
# Token rahasia untuk membuka halaman diagnosa. Kosongkan untuk menonaktifkan.
ADMIN_TOKEN=ubah-token-ini
